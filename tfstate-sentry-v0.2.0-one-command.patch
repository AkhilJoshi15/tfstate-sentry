+package terraformcli
+
+import (
+	"path/filepath"
+	"reflect"
+	"testing"
+)
+
+func TestVariableArgs(t *testing.T) {
+	input := []string{
+		"-var-file=prod.tfvars",
+		"-target=aws_db_instance.main",
+		"-var", "region=us-east-1",
+		"--var-file", "shared.tfvars",
+	}
+	want := []string{
+		"-var-file=prod.tfvars",
+		"-var", "region=us-east-1",
+		"--var-file", "shared.tfvars",
+	}
+	if got := variableArgs(input); !reflect.DeepEqual(got, want) {
+		t.Fatalf("variableArgs()=%v, want %v", got, want)
+	}
+}
+
+func TestAbsolutePlanPath(t *testing.T) {
+	got := AbsolutePlanPath(filepath.Join("tmp", "infra"), "tfplan")
+	want := filepath.Join("tmp", "infra", "tfplan")
+	if got != want {
+		t.Fatalf("AbsolutePlanPath()=%q, want %q", got, want)
+	}
+}
+
+func TestContainsOutFlag(t *testing.T) {
+	for _, args := range [][]string{{"-out=tfplan"}, {"-out", "tfplan"}, {"--out=tfplan"}} {
+		if !containsOutFlag(args) {
+			t.Fatalf("expected output flag to be detected in %v", args)
+		}
+	}
+}
