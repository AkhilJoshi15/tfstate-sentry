+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"os/exec"
+	"path/filepath"
+	"strings"
+)
+
+const maxOutputBytes = 100 << 20 // 100 MiB
+
+// Client executes Terraform using argument arrays rather than a shell.
+type Client struct {
+	Binary string
+	Dir    string
+	Stdin  io.Reader
+	Stdout io.Writer
+	Stderr io.Writer
+}
+
+func (c Client) Plan(ctx context.Context, outputPath string, args []string) error {
+	if strings.TrimSpace(outputPath) == "" {
+		return errors.New("plan output path is required")
+	}
+	if containsOutFlag(args) {
+		return errors.New("pass the saved plan path with tfstate-sentry --out, not terraform -out")
+	}
+
+	commandArgs := []string{"plan", "-out=" + outputPath}
+	commandArgs = append(commandArgs, args...)
+	cmd := c.command(ctx, commandArgs...)
+	cmd.Stdin = c.Stdin
+	cmd.Stdout = c.Stdout
+	cmd.Stderr = c.Stderr
+
+	err := cmd.Run()
+	if err == nil {
+		return nil
+	}
+
+	var exitErr *exec.ExitError
+	if errors.As(err, &exitErr) && exitErr.ExitCode() == 2 && hasDetailedExitCode(args) {
+		return nil
+	}
+	return fmt.Errorf("terraform plan failed: %w", err)
+}
+
+func (c Client) ProviderSchema(ctx context.Context, planArgs []string) ([]byte, error) {
+	args := []string{"providers", "schema", "-json"}
+	args = append(args, variableArgs(planArgs)...)
+	return c.output(ctx, args...)
+}
+
+func (c Client) ShowPlan(ctx context.Context, planPath string) ([]byte, error) {
+	return c.output(ctx, "show", "-json", planPath)
+}
+
+func (c Client) command(ctx context.Context, args ...string) *exec.Cmd {
+	binary := c.Binary
+	if strings.TrimSpace(binary) == "" {
+		binary = "terraform"
+	}
+	cmd := exec.CommandContext(ctx, binary, args...)
+	if strings.TrimSpace(c.Dir) != "" {
+		cmd.Dir = c.Dir
+	}
+	return cmd
+}
+
+func (c Client) output(ctx context.Context, args ...string) ([]byte, error) {
+	var stdout cappedBuffer
+	stdout.limit = maxOutputBytes
+
+	cmd := c.command(ctx, args...)
+	cmd.Stdin = c.Stdin
+	cmd.Stdout = &stdout
+	cmd.Stderr = c.Stderr
+
+	if err := cmd.Run(); err != nil {
+		return nil, fmt.Errorf("terraform %s failed: %w", strings.Join(args, " "), err)
+	}
+	if stdout.exceeded {
+		return nil, fmt.Errorf("terraform %s output exceeds %d MiB limit", strings.Join(args, " "), maxOutputBytes>>20)
+	}
+	return stdout.Bytes(), nil
+}
+
+type cappedBuffer struct {
+	bytes.Buffer
+	limit    int
+	exceeded bool
+}
+
+func (b *cappedBuffer) Write(p []byte) (int, error) {
+	originalLength := len(p)
+	remaining := b.limit - b.Len()
+	if remaining <= 0 {
+		b.exceeded = true
+		return originalLength, nil
+	}
+	if len(p) > remaining {
+		_, _ = b.Buffer.Write(p[:remaining])
+		b.exceeded = true
+		return originalLength, nil
+	}
+	_, _ = b.Buffer.Write(p)
+	return originalLength, nil
+}
+
+func containsOutFlag(args []string) bool {
+	for _, arg := range args {
+		if arg == "-out" || arg == "--out" || strings.HasPrefix(arg, "-out=") || strings.HasPrefix(arg, "--out=") {
+			return true
+		}
+	}
+	return false
+}
+
+func hasDetailedExitCode(args []string) bool {
+	for _, arg := range args {
+		if arg == "-detailed-exitcode" || arg == "--detailed-exitcode" {
+			return true
+		}
+	}
+	return false
+}
+
+func variableArgs(args []string) []string {
+	var result []string
+	for index := 0; index < len(args); index++ {
+		arg := args[index]
+		switch {
+		case arg == "-var" || arg == "--var" || arg == "-var-file" || arg == "--var-file":
+			if index+1 < len(args) {
+				result = append(result, arg, args[index+1])
+				index++
+			}
+		case strings.HasPrefix(arg, "-var=") || strings.HasPrefix(arg, "--var=") ||
+			strings.HasPrefix(arg, "-var-file=") || strings.HasPrefix(arg, "--var-file="):
+			result = append(result, arg)
+		}
+	}
+	return result
+}
+
+// AbsolutePlanPath resolves a relative plan path against the Terraform working directory.
+func AbsolutePlanPath(dir, planPath string) string {
+	if planPath == "" || filepath.IsAbs(planPath) || strings.TrimSpace(dir) == "" {
+		return planPath
+	}
+	return filepath.Join(dir, planPath)
+}
