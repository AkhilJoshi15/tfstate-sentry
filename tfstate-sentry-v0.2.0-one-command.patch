+func writeFakeTerraform(t *testing.T, path string) {
+	t.Helper()
+	script := `#!/bin/sh
+set -eu
+case "$1" in
+  plan)
+    shift
+    output=""
+    for arg in "$@"; do
+      case "$arg" in
+        -out=*) output="${arg#-out=}" ;;
+      esac
+    done
+    test -n "$output"
+    printf 'synthetic-binary-plan' > "$output"
+    echo 'Terraform generated a synthetic plan.'
+    ;;
+  providers)
+    cat "$TFSTATE_SENTRY_SCHEMA_FIXTURE"
+    ;;
+  show)
+    cat "$TFSTATE_SENTRY_PLAN_FIXTURE"
+    ;;
+  *)
+    echo "unexpected Terraform command: $1" >&2
+    exit 1
+    ;;
+esac
+`
+	if err := os.WriteFile(path, []byte(script), 0o700); err != nil {
+		t.Fatal(err)
+	}
+}
